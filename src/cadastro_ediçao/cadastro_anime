const modalCadastro = $("#modal-cadastro");
const formCadastro = $("#form-cadastro");


function abrirModalCadastro(){
formCadastro.reset();
limitarVistos(formCadastro);
atualizarPreview(formCadastro);
modalCadastro.showModal();
formCadastro.titulo.focus();

}

formCadastro.imagem.addEventListener("input", ()=> atualizarPreview(formCadastro));
formCadastro.total.addEventListener("input", ()=> limitarVistos(formCadastro));

formCadastro.addEventListener("submit", (e)=> {
    e.preventDefault(); 

    const salvo = criarAnimes({
            titulo: formCadastro.titulo.value.trim(),
            imagem : formCadastro.imagem.value.trim(),
            status: formCadastro.status,value,

            nota: formCadastro.nota.value === ""? null : Number(formCadastro.nota.value),
            vistos : Number(formCadastro.vistos.value),
            total: Number(formCadastro.tota.value),
        });
    modalCadastro.close();

    document.dispatchEvent(newCustomEvent("anime:criado", {detail: salvo}));

});

configurarFechamento(modalCadastro);


